rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function inactiveStatus(s) {
      return s in [
        'disabled',
        'DISABLED',
        'inactive',
        'INACTIVE',
        'suspended',
        'SUSPENDED',
        'blocked',
        'BLOCKED'
      ];
    }

    // ============================================================
    // ADMIN
    // ============================================================

    function isActiveAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admins/$(uid())
        )
        && get(
          /databases/$(database)/documents/admins/$(uid())
        ).data.get('active', true) != false
        && !inactiveStatus(
          get(
            /databases/$(database)/documents/admins/$(uid())
          ).data.get('status', 'active')
        );
    }

    // ============================================================
    // STAFF
    // ============================================================

    function staffClientId() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/staffUsers/$(uid())
        )
        && get(
          /databases/$(database)/documents/staffUsers/$(uid())
        ).data.get('active', true) != false
        && !inactiveStatus(
          get(
            /databases/$(database)/documents/staffUsers/$(uid())
          ).data.get('status', 'active')
        )
          ? get(
              /databases/$(database)/documents/staffUsers/$(uid())
            ).data.get('clientId', '')
          : '';
    }

    function adminClientId() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/admins/$(uid())
        )
          ? get(
              /databases/$(database)/documents/admins/$(uid())
            ).data.get('clientId', '')
          : '';
    }

    // Super Admin is an informational role marker only. Firestore data access
    // remains bound to the single client assignment, including for that role.
    function isAdminOf(clientId) {
      return isActiveAdmin()
        && clientId is string
        && clientId != ''
        && adminClientId() == clientId;
    }

    function isStaffUserOf(clientId) {
      return signedIn()
        && clientId is string
        && clientId != ''
        && staffClientId() == clientId;
    }

    function canAccessClient(clientId) {
      return isAdminOf(clientId)
        || isStaffUserOf(clientId);
    }

    // ============================================================
    // PUBLIC CLIENT
    // ============================================================

    function isPublished(data) {
      return !('status' in data)
        || data.status in [
          'PUBLISHED',
          'published',
          'ACTIVE',
          'active',
          'LIVE',
          'live'
        ];
    }

    function clientIsPublic(clientId) {
      return clientId is string
        && clientId != ''
        && exists(
          /databases/$(database)/documents/clients/$(clientId)
        )
        && isPublished(
          get(
            /databases/$(database)/documents/clients/$(clientId)
          ).data
        );
    }

    // The Staff App currently writes loyaltyAccounts/{customerId}.stamps and
    // serverTimestamp() into lastStampAt. Firestore Rules use request.time,
    // never a client-supplied timestamp, as the authoritative cooldown clock.
    function validStampTarget(value) {
      return value is int && value >= 1 && value <= 30;
    }

    function configuredClientStampTarget(clientId) {
      return (
        'loyalty' in get(/databases/$(database)/documents/clients/$(clientId)).data
        && get(/databases/$(database)/documents/clients/$(clientId)).data.loyalty is map
        && get(/databases/$(database)/documents/clients/$(clientId)).data.loyalty.get('stampTarget', 0) is int
        && validStampTarget(get(/databases/$(database)/documents/clients/$(clientId)).data.loyalty.get('stampTarget', 0))
      )
        ? get(/databases/$(database)/documents/clients/$(clientId)).data.loyalty.stampTarget
        : validStampTarget(get(/databases/$(database)/documents/clients/$(clientId)).data.get('stampTarget', 0))
          ? get(/databases/$(database)/documents/clients/$(clientId)).data.get('stampTarget', 0)
          : validStampTarget(get(/databases/$(database)/documents/clients/$(clientId)).data.get('stampsRequired', 0))
            ? get(/databases/$(database)/documents/clients/$(clientId)).data.get('stampsRequired', 0)
            : validStampTarget(get(/databases/$(database)/documents/clients/$(clientId)).data.get('stampsForReward', 0))
              ? get(/databases/$(database)/documents/clients/$(clientId)).data.get('stampsForReward', 0)
              : 8;
    }

    function effectiveStampTarget(clientId, loyaltyData) {
      return validStampTarget(loyaltyData.get('stampTarget', 0))
        ? loyaltyData.get('stampTarget', 0)
        : configuredClientStampTarget(clientId);
    }

    function oldRewardCount(data) {
      return data.get('totalRewardsRedeemed', 0) is int
        && data.get('totalRewardsRedeemed', 0) >= 0
          ? data.get('totalRewardsRedeemed', 0)
          : 0;
    }

    function stampCooldownElapsed(data) {
      return data.get('lastStampAt', null) is timestamp
        ? request.time >= data.get('lastStampAt', null) + duration.value(12, 'h')
        : data.get('lastStampAt', null) == null
          && data.get('stamps', 0) == 0
          && data.get('currentStamps', 0) == 0
          && data.get('lifetimeStamps', 0) == 0;
    }

    // ============================================================
    // VALIDATION HELPERS
    // ============================================================

    function optStr(data, key, max) {
      return !(key in data)
        || data[key] == null
        || (
          data[key] is string
          && data[key].size() <= max
        );
    }

    function strList(v, maxItems, maxLen) {
      return v is list
        && v.size() <= maxItems
        && (
          v.size() == 0
          || (
            v[0] is string
            && v[0].size() <= maxLen
          )
        );
    }

    function validName(n) {
      return n is string
        && n.size() >= 2
        && n.size() <= 50;
    }

    function validPhone(p) {
      return p is string
        && p.matches('^[+]91[6-9][0-9]{9}$');
    }

    function validEmail(e) {
      return e == null
        || (
          e is string
          && e.size() <= 254
          && e.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        );
    }

    function phoneKey(clientId, phone) {
      return clientId + '_' + phone[1:];
    }

    // ============================================================
    // QR TOKEN ATOMIC VALIDATION
    // ============================================================

    function tokenAfterMatches(token, owner, clientId) {
      return token is string
        && token.matches('^[a-f0-9]{64}$')
        && getAfter(
          /databases/$(database)/documents/customerTokens/$(token)
        ).data.customerId == owner
        && getAfter(
          /databases/$(database)/documents/customerTokens/$(token)
        ).data.clientId == clientId;
    }

    // ============================================================
    // ADMINS
    // ============================================================

    match /admins/{adminId} {
      allow get: if signedIn() && uid() == adminId;
    }

    // ============================================================
    // STAFF REGISTRY
    // ============================================================

    match /staffUsers/{staffId} {

      allow get: if signedIn() && uid() == staffId
        || isAdminOf(resource.data.get('clientId', ''));

      allow list: if (staffClientId() != ''
          && resource.data.clientId == staffClientId())
        || isAdminOf(resource.data.get('clientId', ''));

      allow create: if isAdminOf(request.resource.data.get('clientId', ''));

      allow update: if isAdminOf(resource.data.get('clientId', ''))
        && request.resource.data.get('clientId', '') == resource.data.get('clientId', '');

      allow delete: if isAdminOf(resource.data.get('clientId', ''));
    }

    // ============================================================
    // CLIENTS / BUSINESSES
    // ============================================================

    match /clients/{clientId} {

      // Public customer application can read published businesses. Staff and
      // Admins can read only the business assigned to their account.
      allow get:
        if isPublished(resource.data)
        || canAccessClient(clientId);

      // Customer App resolves published businesses by slug. An Admin may also
      // list only documents in the assigned business scope.
      allow list:
        if resource.data.status == 'PUBLISHED'
        || isAdminOf(clientId);

      allow create, update, delete: if isAdminOf(clientId);

      // ----------------------------------------------------------
      // MENU CATEGORIES
      // ----------------------------------------------------------

      match /menuCategories/{categoryId} {
        allow read:
          if clientIsPublic(clientId)
          || canAccessClient(clientId);
        allow write: if isAdminOf(clientId);
      }

      // ----------------------------------------------------------
      // MENU ITEMS
      // ----------------------------------------------------------

      match /menuItems/{itemId} {
        allow read:
          if clientIsPublic(clientId)
          || canAccessClient(clientId);
        allow write: if isAdminOf(clientId);
      }

      // ----------------------------------------------------------
      // REWARDS
      // ----------------------------------------------------------

      match /rewards/{rewardId} {
        allow read:
          if clientIsPublic(clientId)
          || canAccessClient(clientId);
        allow write: if isAdminOf(clientId);
      }

      // ----------------------------------------------------------
      // QR CONFIGURATIONS
      // ----------------------------------------------------------

      match /qrConfigurations/{qrId} {
        allow read:
          if canAccessClient(clientId);
        allow write: if isAdminOf(clientId);
      }

      // ==========================================================
      // STAMP TRANSACTIONS
      // ==========================================================

      match /stampTransactions/{transactionId} {
        function loyaltyPath(customerId) {
          return /databases/$(database)/documents/loyaltyAccounts/$(customerId);
        }

        // Staff/Admin see only this client's history. A customer can read only
        // their own ledger rows, and only under the business on their profile.
        allow read:
          if canAccessClient(clientId)
          || (
            signedIn()
            && resource.data.get('customerId', '') == uid()
            && (!('clientId' in resource.data) || resource.data.clientId == clientId)
            && exists(/databases/$(database)/documents/customers/$(uid()))
            && get(/databases/$(database)/documents/customers/$(uid())).data.get('clientId', '') == clientId
          );

        // The deployed Staff App first creates an uncounted reservation. It
        // cannot reserve a stamp during cooldown; request.time is Firebase's
        // server clock and lastStampAt is the prior successful account value.
        allow create:
          if isStaffUserOf(clientId)
          && transactionId.matches('^[A-Za-z0-9_-]{1,128}$')
          && request.resource.data.keys().hasOnly([
            'clientId', 'customerId', 'transactionId', 'staffId', 'staffUid',
            'staffName', 'actorType', 'actorName', 'type', 'title', 'description',
            'reason', 'delta', 'addedCount', 'customerName', 'customerCode',
            'visitCounted', 'stampCountBefore', 'stampCountAfter', 'stampTarget',
            'rewardName', 'rewardUnlocked', 'notes', 'badgeText', 'badgeType', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'clientId', 'customerId', 'transactionId', 'staffId', 'staffUid',
            'type', 'visitCounted', 'createdAt'
          ])
          && request.resource.data.clientId == clientId
          && request.resource.data.customerId is string
          && request.resource.data.customerId != ''
          && request.resource.data.transactionId == transactionId
          && request.resource.data.staffId == uid()
          && request.resource.data.staffUid == uid()
          && request.resource.data.visitCounted == false
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId))
          && get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.get('clientId', '') == clientId
          && (
            (
              request.resource.data.type == 'STAMP_ADDED'
              && request.resource.data.delta == 1
              && request.resource.data.get('addedCount', 0) == 1
              && (
                !exists(loyaltyPath(request.resource.data.customerId))
                || (
                  get(loyaltyPath(request.resource.data.customerId)).data.get('clientId', '') == clientId
                  && get(loyaltyPath(request.resource.data.customerId)).data.get('customerId', request.resource.data.customerId) == request.resource.data.customerId
                  && stampCooldownElapsed(get(loyaltyPath(request.resource.data.customerId)).data)
                )
              )
            )
            || (
              request.resource.data.type == 'REWARD_REDEEMED'
              && request.resource.data.delta is int
              && request.resource.data.delta < 0
              && existsAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(transactionId))
              && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(transactionId)).data.get('clientId', '') == clientId
              && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(transactionId)).data.get('customerId', '') == request.resource.data.customerId
              && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(transactionId)).data.get('staffUid', '') == uid()
            )
          );

        // Phase two is the only successful stamp commit: update the reservation,
        // loyalty balance, and customer visit together. The account rule below
        // independently repeats the cooldown check, preventing direct writes.
        allow update:
          if isStaffUserOf(clientId)
          && resource.data.get('clientId', '') == clientId
          && resource.data.get('type', '') == 'STAMP_ADDED'
          && resource.data.get('staffId', '') == uid()
          && resource.data.get('staffUid', '') == uid()
          && request.resource.data.get('clientId', '') == clientId
          && request.resource.data.get('customerId', '') == resource.data.get('customerId', '')
          && request.resource.data.get('transactionId', '') == transactionId
          && request.resource.data.get('staffId', '') == uid()
          && request.resource.data.get('staffUid', '') == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'visitCounted', 'visitCountedAt', 'stampCountBefore', 'stampCountAfter',
            'stampTarget', 'rewardName', 'rewardUnlocked'
          ])
          && request.resource.data.visitCounted == true
          && resource.data.get('visitCounted', false) != true
          && request.resource.data.visitCountedAt == request.time
          && request.resource.data.stampCountBefore is int
          && request.resource.data.stampCountBefore >= 0
          && request.resource.data.stampCountAfter is int
          && request.resource.data.stampCountAfter == request.resource.data.stampCountBefore + 1
          && validStampTarget(request.resource.data.stampTarget)
          && request.resource.data.rewardName is string
          && request.resource.data.rewardName.size() > 0
          && request.resource.data.rewardName.size() <= 120
          && request.resource.data.rewardUnlocked == (request.resource.data.stampCountAfter >= request.resource.data.stampTarget)
          && (
            (
              !exists(loyaltyPath(request.resource.data.customerId))
              && request.resource.data.stampCountBefore == 0
            )
            || (
              exists(loyaltyPath(request.resource.data.customerId))
              && get(loyaltyPath(request.resource.data.customerId)).data.get('clientId', '') == clientId
              && get(loyaltyPath(request.resource.data.customerId)).data.get('customerId', request.resource.data.customerId) == request.resource.data.customerId
              && get(loyaltyPath(request.resource.data.customerId)).data.get('stamps', 0) == request.resource.data.stampCountBefore
              && stampCooldownElapsed(get(loyaltyPath(request.resource.data.customerId)).data)
            )
          )
          && existsAfter(loyaltyPath(request.resource.data.customerId))
          && getAfter(loyaltyPath(request.resource.data.customerId)).data.get('clientId', '') == clientId
          && getAfter(loyaltyPath(request.resource.data.customerId)).data.get('customerId', '') == request.resource.data.customerId
          && getAfter(loyaltyPath(request.resource.data.customerId)).data.get('stamps', -1) == request.resource.data.stampCountAfter
          && getAfter(loyaltyPath(request.resource.data.customerId)).data.get('stampTarget', 0) == request.resource.data.stampTarget
          && getAfter(loyaltyPath(request.resource.data.customerId)).data.get('rewardName', '') == request.resource.data.rewardName
          && getAfter(loyaltyPath(request.resource.data.customerId)).data.get('isEligibleForReward', false) == request.resource.data.rewardUnlocked
          && getAfter(loyaltyPath(request.resource.data.customerId)).data.get('lastStampAt', null) == request.time
          && existsAfter(/databases/$(database)/documents/customers/$(request.resource.data.customerId))
          && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.get('clientId', '') == clientId
          && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.get('lastVisitTransactionId', '') == transactionId;

        allow delete: if false;
      }

      // ==========================================================
      // REWARD REDEMPTIONS
      // ==========================================================

      match /rewardRedemptions/{redemptionId} {
        allow read: if canAccessClient(clientId);

        // Redemption, immutable history row, and loyalty deduction must commit
        // together. The transaction ID is create-only, so retries cannot redeem
        // the same reward twice.
        allow create:
          if isStaffUserOf(clientId)
          && request.resource.data.keys().hasOnly([
            'clientId', 'customerId', 'customerName', 'customerCode', 'rewardName',
            'stampCost', 'stampsResetFrom', 'stampsResetTo', 'staffUid', 'staffId',
            'staffName', 'actorType', 'actorName', 'transactionId', 'redeemedAt', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'clientId', 'customerId', 'rewardName', 'stampCost', 'stampsResetFrom',
            'stampsResetTo', 'staffUid', 'staffId', 'transactionId', 'redeemedAt', 'createdAt'
          ])
          && request.resource.data.clientId == clientId
          && request.resource.data.transactionId == redemptionId
          && request.resource.data.staffUid == uid()
          && request.resource.data.staffId == uid()
          && request.resource.data.customerId is string
          && request.resource.data.customerId != ''
          && validStampTarget(request.resource.data.stampCost)
          && exists(/databases/$(database)/documents/customers/$(request.resource.data.customerId))
          && get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.get('clientId', '') == clientId
          && exists(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId))
          && get(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.get('clientId', '') == clientId
          && get(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.get('customerId', request.resource.data.customerId) == request.resource.data.customerId
          && get(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.get('stamps', 0) is int
          && get(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.get('stamps', 0) >= request.resource.data.stampCost
          && request.resource.data.stampCost == effectiveStampTarget(
            clientId,
            get(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data
          )
          && request.resource.data.stampsResetFrom == get(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.stamps
          && request.resource.data.stampsResetTo == request.resource.data.stampsResetFrom - request.resource.data.stampCost
          && request.resource.data.redeemedAt == request.time
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId))
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId)).data.get('clientId', '') == clientId
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId)).data.get('customerId', '') == request.resource.data.customerId
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId)).data.get('staffId', '') == uid()
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId)).data.get('staffUid', '') == uid()
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId)).data.get('type', '') == 'REWARD_REDEEMED'
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId)).data.get('delta', 0) == -request.resource.data.stampCost
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId)).data.get('createdAt', null) == request.time
          && getAfter(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.get('clientId', '') == clientId
          && getAfter(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.get('customerId', '') == request.resource.data.customerId
          && getAfter(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.get('stamps', -1) == request.resource.data.stampsResetTo
          && getAfter(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.get('isEligibleForReward', true) == (request.resource.data.stampsResetTo >= request.resource.data.stampCost)
          && getAfter(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.get('totalRewardsRedeemed', 0) == oldRewardCount(get(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data) + 1
          && getAfter(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.customerId)).data.get('lastRewardRedemptionId', '') == redemptionId;

        allow update, delete: if false;
      }

      // ==========================================================
      // FEEDBACK
      // ==========================================================

      match /feedback/{feedbackId} {

        allow create:
          if signedIn()
          && clientIsPublic(clientId)
          && request.resource.data.keys().hasOnly([
            'clientId',
            'message',
            'rating',
            'table',
            'location',
            'createdAt'
          ])
          && request.resource.data.clientId == clientId
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 3
          && request.resource.data.message.size() <= 2000
          && (
            request.resource.data.rating == null
            || (
              request.resource.data.rating is int
              && request.resource.data.rating >= 1
              && request.resource.data.rating <= 5
            )
          )
          && optStr(
            request.resource.data,
            'table',
            32
          )
          && optStr(
            request.resource.data,
            'location',
            32
          )
          && request.resource.data.createdAt == request.time;

        allow read:
          if canAccessClient(clientId);

        // Status-only moderation preserves the anonymous feedback payload.
        allow update:
          if isAdminOf(clientId)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          && request.resource.data.get('clientId', '') == clientId
          && request.resource.data.get('status', '') in [
            'new', 'NEW', 'pending', 'PENDING',
            'read', 'READ', 'resolved', 'RESOLVED'
          ]
          && request.resource.data.updatedAt == request.time;
      }

      // ==========================================================
      // REVIEWS
      // ==========================================================

      match /reviews/{reviewId} {

        allow create:
          if signedIn()
          && clientIsPublic(clientId)
          && request.resource.data.keys().hasOnly([
            'clientId',
            'customerId',
            'overallRating',
            'staffRating',
            'serviceRating',
            'selectedItems',
            'itemsTried',
            'menuItemIds',
            'generatedReview',
            'provider',
            'table',
            'location',
            'createdAt'
          ])
          && request.resource.data.clientId == clientId
          && request.resource.data.customerId == uid()
          && request.resource.data.generatedReview is string
          && request.resource.data.generatedReview.size() <= 4000
          && strList(
            request.resource.data.selectedItems,
            20,
            80
          )
          && (
            !('itemsTried' in request.resource.data)
            || strList(
              request.resource.data.itemsTried,
              20,
              80
            )
          )
          && (
            !('menuItemIds' in request.resource.data)
            || strList(
              request.resource.data.menuItemIds,
              20,
              128
            )
          )
          && optStr(
            request.resource.data,
            'overallRating',
            40
          )
          && optStr(
            request.resource.data,
            'staffRating',
            40
          )
          && optStr(
            request.resource.data,
            'serviceRating',
            40
          )
          && optStr(
            request.resource.data,
            'provider',
            16
          )
          && optStr(
            request.resource.data,
            'table',
            32
          )
          && optStr(
            request.resource.data,
            'location',
            32
          )
          && request.resource.data.createdAt == request.time;

        allow read:
          if canAccessClient(clientId);
      }

      // ==========================================================
      // ANALYTICS EVENTS
      // ==========================================================

      match /events/{eventId} {

        allow create:
          if signedIn()
          && clientIsPublic(clientId)
          && request.resource.data.keys().hasOnly([
            'clientId',
            'eventType',
            'timestamp',
            'customerId',
            'menuItemId',
            'tableId',
            'network'
          ])
          && request.resource.data.clientId == clientId
          && request.resource.data.eventType in [
            'QR_OPENED',
            'MENU_VIEWED',
            'MENU_ITEM_VIEWED',
            'GOOGLE_REVIEW_CLICKED',
            'SOCIAL_CLICKED',
            'WIFI_VIEWED',
            'FEEDBACK_SUBMITTED',
            'AI_REVIEW_GENERATED',
            'LOYALTY_VIEWED'
          ]
          && request.resource.data.timestamp == request.time
          && (
            !('customerId' in request.resource.data)
            || request.resource.data.customerId == uid()
          )
          && optStr(
            request.resource.data,
            'menuItemId',
            128
          )
          && optStr(
            request.resource.data,
            'tableId',
            32
          )
          && optStr(
            request.resource.data,
            'network',
            32
          );

        allow read:
          if canAccessClient(clientId);
      }

      // Real Staff notifications stay tenant-scoped and immutable apart from
      // their read flag. They are not synthetic Admin notifications.
      match /notifications/{notificationId} {
        allow read: if isStaffUserOf(clientId) || isAdminOf(clientId);

        allow create:
          if isStaffUserOf(clientId)
          && request.resource.data.get('clientId', '') == clientId
          && request.resource.data.get('type', '') in ['REWARD_READY', 'STAMP_ADDED', 'REWARD_REDEEMED', 'SYSTEM']
          && request.resource.data.get('title', '') is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.get('message', '') is string
          && request.resource.data.message.size() <= 400
          && request.resource.data.get('read', true) == false
          && request.resource.data.get('staffUid', '') == uid()
          && request.resource.data.get('createdAt', null) == request.time;

        allow update:
          if isStaffUserOf(clientId)
          && resource.data.get('clientId', clientId) == clientId
          && request.resource.data.get('clientId', clientId) == clientId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;

        allow delete: if false;
      }

      // Admin read access to any canonical client subcollection is still scoped
      // by the business id in the document path. This does not grant writes.
      match /{subcollection}/{document=**} {
        allow read: if isAdminOf(clientId);
      }
    }

    // ============================================================
    // LOYALTY ACCOUNTS
    // ============================================================

    match /loyaltyAccounts/{customerId} {
      function loyaltyStampBaseline() {
        return resource == null ? 0 : resource.data.get('stamps', 0);
      }

      function assignedStaffForCustomer() {
        return signedIn()
          && staffClientId() != ''
          && exists(/databases/$(database)/documents/customers/$(customerId))
          && get(/databases/$(database)/documents/customers/$(customerId)).data.get('clientId', '') == staffClientId();
      }

      function matchingStampTransaction(clientId, transactionId) {
        return transactionId is string
          && transactionId != ''
          && exists(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId))
          && get(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('clientId', '') == clientId
          && get(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('customerId', '') == customerId
          && get(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('transactionId', '') == transactionId
          && get(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('type', '') == 'STAMP_ADDED'
          && get(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('staffId', '') == uid()
          && get(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('staffUid', '') == uid()
          && get(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('visitCounted', false) != true
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('stampCountBefore', -1) == loyaltyStampBaseline()
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('stampCountAfter', -1) == loyaltyStampBaseline() + 1
          && validStampTarget(getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('stampTarget', 0))
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('rewardUnlocked', false)
            == (getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('stampCountAfter', -1)
              >= getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('stampTarget', 0))
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('visitCounted', false) == true
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(transactionId)).data.get('visitCountedAt', null) == request.time;
      }

      function validStampAccountMutation(clientId) {
        return existsAfter(/databases/$(database)/documents/customers/$(customerId))
          && getAfter(/databases/$(database)/documents/customers/$(customerId)).data.get('clientId', '') == clientId
          && getAfter(/databases/$(database)/documents/customers/$(customerId)).data.get('lastVisitTransactionId', '') is string
          && getAfter(/databases/$(database)/documents/customers/$(customerId)).data.get('lastVisitTransactionId', '') != ''
          && matchingStampTransaction(
            clientId,
            getAfter(/databases/$(database)/documents/customers/$(customerId)).data.get('lastVisitTransactionId', '')
          );
      }

      function matchingRewardMutation(clientId, redemptionId) {
        return redemptionId is string
          && redemptionId != ''
          && existsAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId))
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('clientId', '') == clientId
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('customerId', '') == customerId
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('transactionId', '') == redemptionId
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('staffUid', '') == uid()
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('staffId', '') == uid()
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('stampCost', 0) is int
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('stampCost', 0) >= 1
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('stampCost', 0) <= 30
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('stampsResetFrom', -1) == loyaltyStampBaseline()
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('stampsResetTo', -1) == request.resource.data.get('stamps', -1)
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('stampsResetTo', -1)
            == loyaltyStampBaseline() - getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('stampCost', 0)
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('redeemedAt', null) == request.time
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('createdAt', null) == request.time
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId)).data.get('type', '') == 'REWARD_REDEEMED'
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId)).data.get('delta', 0)
            == -getAfter(/databases/$(database)/documents/clients/$(clientId)/rewardRedemptions/$(redemptionId)).data.get('stampCost', 0)
          && getAfter(/databases/$(database)/documents/clients/$(clientId)/stampTransactions/$(redemptionId)).data.get('createdAt', null) == request.time;
      }

      // Customers can read only their own account, even when it does not exist.
      allow get: if signedIn() && uid() == customerId;
      allow get: if canAccessClient(resource.data.get('clientId', ''));
      allow get: if resource == null && assignedStaffForCustomer();
      allow list: if (staffClientId() != '' && resource.data.get('clientId', '') == staffClientId())
        || isAdminOf(resource.data.get('clientId', ''));

      // Staff can create the first account only as part of the two-document
      // successful visit commit. New fields used only by a future writer are
      // deliberately not assumed; the deployed Staff schema remains supported.
      allow create:
        if isStaffUserOf(request.resource.data.get('clientId', ''))
        && uid() != customerId
        && request.resource.data.keys().hasOnly([
          'clientId', 'customerId', 'stamps', 'stampTarget', 'rewardName',
          'isEligibleForReward', 'lastStampAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'clientId', 'customerId', 'stamps', 'stampTarget', 'rewardName',
          'isEligibleForReward', 'lastStampAt', 'updatedAt'
        ])
        && request.resource.data.clientId is string
        && request.resource.data.clientId != ''
        && request.resource.data.customerId == customerId
        && exists(/databases/$(database)/documents/customers/$(customerId))
        && get(/databases/$(database)/documents/customers/$(customerId)).data.get('clientId', '') == request.resource.data.clientId
        && request.resource.data.stamps is int
        && request.resource.data.stamps == 1
        && validStampTarget(request.resource.data.stampTarget)
        && request.resource.data.rewardName is string
        && request.resource.data.rewardName.size() > 0
        && request.resource.data.rewardName.size() <= 120
        && request.resource.data.isEligibleForReward == (request.resource.data.stamps >= request.resource.data.stampTarget)
        && request.resource.data.lastStampAt == request.time
        && request.resource.data.updatedAt == request.time
        && validStampAccountMutation(request.resource.data.clientId);

      allow update:
        if isStaffUserOf(resource.data.get('clientId', ''))
        && uid() != customerId
        && request.resource.data.get('clientId', '') == resource.data.get('clientId', '')
        && request.resource.data.customerId == customerId
        && exists(/databases/$(database)/documents/customers/$(customerId))
        && get(/databases/$(database)/documents/customers/$(customerId)).data.get('clientId', '') == resource.data.get('clientId', '')
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'stamps', 'stampTarget', 'rewardName', 'isEligibleForReward', 'lastStampAt', 'updatedAt'
            ])
            && loyaltyStampBaseline() is int
            && loyaltyStampBaseline() >= 0
            && request.resource.data.stamps is int
            && request.resource.data.stamps == loyaltyStampBaseline() + 1
            && validStampTarget(request.resource.data.stampTarget)
            && request.resource.data.rewardName is string
            && request.resource.data.rewardName.size() > 0
            && request.resource.data.rewardName.size() <= 120
            && request.resource.data.isEligibleForReward == (request.resource.data.stamps >= request.resource.data.stampTarget)
            && request.resource.data.lastStampAt == request.time
            && request.resource.data.updatedAt == request.time
            && stampCooldownElapsed(resource.data)
            && validStampAccountMutation(resource.data.get('clientId', ''))
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'stamps', 'isEligibleForReward', 'totalRewardsRedeemed',
              'lastRewardRedeemedAt', 'lastRewardRedemptionId', 'updatedAt'
            ])
            && loyaltyStampBaseline() is int
            && loyaltyStampBaseline() >= 1
            && request.resource.data.stamps is int
            && request.resource.data.stamps >= 0
            && request.resource.data.totalRewardsRedeemed is int
            && request.resource.data.totalRewardsRedeemed == oldRewardCount(resource.data) + 1
            && request.resource.data.lastRewardRedeemedAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.get('lastRewardRedemptionId', '') is string
            && request.resource.data.get('lastRewardRedemptionId', '') != ''
            && matchingRewardMutation(resource.data.get('clientId', ''), request.resource.data.lastRewardRedemptionId)
            && request.resource.data.isEligibleForReward == (
              request.resource.data.stamps >= getAfter(
                /databases/$(database)/documents/clients/$(resource.data.get('clientId', ''))/rewardRedemptions/$(request.resource.data.lastRewardRedemptionId)
              ).data.get('stampCost', 0)
            )
          )
        );

      allow delete: if false;
    }

    // ============================================================
    // CUSTOMERS
    // ============================================================

    match /customers/{customerId} {

      function d() {
        return request.resource.data;
      }

      function changed() {
        return d().diff(resource.data).affectedKeys();
      }

      function oldVisits() {
        return resource.data.get(
          'totalVisits',
          0
        ) is int
          ? resource.data.get('totalVisits', 0)
          : 0;
      }

      function ownsIndexAfter(
        indexId,
        clientId,
        phone
      ) {
        return getAfter(
          /databases/$(database)/documents/customerPhoneIndex/$(indexId)
        ).data.customerId == customerId
          && getAfter(
            /databases/$(database)/documents/customerPhoneIndex/$(indexId)
          ).data.phone == phone
          && getAfter(
            /databases/$(database)/documents/customerPhoneIndex/$(indexId)
          ).data.clientId == clientId;
      }

      function visitTx(txId) {
        return /databases/$(database)/documents/clients/$(resource.data.clientId)/stampTransactions/$(txId);
      }

      function visitTxBelongsToCustomer(txId) {
        return exists(
          visitTx(txId)
        )
        && get(
          visitTx(txId)
        ).data.get('customerId', '') == customerId
        && get(
          visitTx(txId)
        ).data.get('clientId', '') == resource.data.clientId;
      }

      // ----------------------------------------------------------
      // Customer own document
      // ----------------------------------------------------------

      allow get:
        if signedIn()
        && uid() == customerId;

      // Staff and Admin may read only customers in their assigned business.
      allow get:
        if canAccessClient(
          resource.data.get('clientId', '')
        );

      allow list:
        if (staffClientId() != '' && resource.data.clientId == staffClientId())
        || isAdminOf(resource.data.get('clientId', ''));

      // ----------------------------------------------------------
      // CUSTOMER REGISTRATION
      // ----------------------------------------------------------

      allow create:
        if signedIn()
        && uid() == customerId

        && d().keys().hasOnly([
          'uid',
          'clientId',
          'name',
          'phone',
          'normalizedPhone',
          'phoneIndexId',
          'email',
          'totalVisits',
          'lastVisitAt',
          'status',
          'createdAt',
          'updatedAt',
          'qrToken'
        ])

        && d().keys().hasAll([
          'uid',
          'clientId',
          'name',
          'phone',
          'normalizedPhone',
          'phoneIndexId',
          'email',
          'totalVisits',
          'lastVisitAt',
          'status',
          'createdAt',
          'updatedAt',
          'qrToken'
        ])

        && d().uid == customerId
        && d().status == 'active'
        && d().totalVisits == 0
        && d().lastVisitAt == null

        && validName(d().name)

        && validPhone(d().normalizedPhone)
        && d().phone == d().normalizedPhone

        && validEmail(
          d().get('email', null)
        )

        && clientIsPublic(
          d().clientId
        )

        && d().phoneIndexId
          == phoneKey(
            d().clientId,
            d().normalizedPhone
          )

        && ownsIndexAfter(
          d().phoneIndexId,
          d().clientId,
          d().normalizedPhone
        )

        && tokenAfterMatches(
          d().qrToken,
          customerId,
          d().clientId
        )

        && d().createdAt == request.time
        && d().updatedAt == request.time;

      // ----------------------------------------------------------
      // CUSTOMER PROFILE UPDATE
      // ----------------------------------------------------------

      allow update:
        if signedIn()
        && uid() == customerId

        && changed().hasOnly([
          'name',
          'phone',
          'normalizedPhone',
          'phoneIndexId',
          'email',
          'updatedAt',
          'qrToken'
        ])

        && d().updatedAt == request.time

        && validName(d().name)

        && validEmail(
          d().get('email', null)
        )

        // Phone change requires atomic phone index movement.
        && (
          !changed().hasAny([
            'phone',
            'normalizedPhone',
            'phoneIndexId'
          ])

          || (
            validPhone(d().normalizedPhone)
            && d().phone == d().normalizedPhone
            && d().phoneIndexId
              == phoneKey(
                resource.data.clientId,
                d().normalizedPhone
              )

            && ownsIndexAfter(
              d().phoneIndexId,
              resource.data.clientId,
              d().normalizedPhone
            )

            && (
              resource.data.get(
                'phoneIndexId',
                null
              ) == null

              || resource.data.phoneIndexId
                == d().phoneIndexId

              || !existsAfter(
                /databases/$(database)/documents/customerPhoneIndex/$(resource.data.phoneIndexId)
              )
            )
          )
        )

        // QR token can only be added once.
        && (
          !changed().hasAny(['qrToken'])
          || (
            !('qrToken' in resource.data)
            && tokenAfterMatches(
              d().qrToken,
              customerId,
              resource.data.clientId
            )
          )
        );

      // ----------------------------------------------------------
      // STAFF VISIT COUNTING
      // ----------------------------------------------------------

      allow update:
        if signedIn()
        && uid() != customerId

        && isStaffUserOf(
          resource.data.get('clientId', '')
        )

        && changed().hasOnly([
          'totalVisits',
          'lastVisitAt',
          'updatedAt',
          'lastVisitTransactionId'
        ])

        && d().totalVisits
          == oldVisits() + 1

        && d().lastVisitAt == request.time
        && d().updatedAt == request.time

        && d().lastVisitTransactionId is string

        // Transaction must belong to this customer and business.
        && visitTxBelongsToCustomer(
          d().lastVisitTransactionId
        )

        // Transaction was uncounted before this atomic write.
        && get(
          visitTx(
            d().lastVisitTransactionId
          )
        ).data.get(
          'visitCounted',
          false
        ) != true

        // Transaction becomes counted in the same atomic commit.
        && getAfter(
          visitTx(
            d().lastVisitTransactionId
          )
        ).data.get(
          'visitCounted',
          false
        ) == true;
    }

    // ============================================================
    // CUSTOMER PHONE INDEX
    // ============================================================

    match /customerPhoneIndex/{phoneIndexId} {

      function d() {
        return request.resource.data;
      }

      function ownerAfter() {
        return getAfter(
          /databases/$(database)/documents/customers/$(uid())
        ).data;
      }

      // Owner only.
      allow get:
        if signedIn()
        && resource.data.customerId == uid();

      // Staff/Admin may resolve indexes only for their own business.
      allow get:
        if canAccessClient(
          resource.data.get('clientId', '')
        );

      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------

      allow create:
        if signedIn()

        && d().keys().hasOnly([
          'phone',
          'clientId',
          'customerId',
          'createdAt',
          'updatedAt'
        ])

        && d().customerId == uid()

        && validPhone(d().phone)

        && clientIsPublic(
          d().clientId
        )

        && phoneIndexId
          == phoneKey(
            d().clientId,
            d().phone
          )

        && ownerAfter().phoneIndexId
          == phoneIndexId

        && ownerAfter().normalizedPhone
          == d().phone

        && ownerAfter().clientId
          == d().clientId

        && d().createdAt == request.time
        && d().updatedAt == request.time;

      // ----------------------------------------------------------
      // DELETE DURING ATOMIC PHONE CHANGE
      // ----------------------------------------------------------

      allow delete:
        if signedIn()
        && resource.data.customerId == uid()
        && ownerAfter().get(
          'phoneIndexId',
          ''
        ) != phoneIndexId;
    }

    // ============================================================
    // CUSTOMER QR TOKENS
    // ============================================================

    match /customerTokens/{token} {

      // Created atomically with customers/{uid}.
      allow create:
        if signedIn()

        && token.matches(
          '^[a-f0-9]{64}$'
        )

        && request.resource.data.keys().hasOnly([
          'customerId',
          'clientId',
          'createdAt'
        ])

        && request.resource.data.customerId == uid()

        && request.resource.data.clientId is string
        && request.resource.data.clientId != ''

        && getAfter(
          /databases/$(database)/documents/customers/$(uid())
        ).data.qrToken == token

        && getAfter(
          /databases/$(database)/documents/customers/$(uid())
        ).data.clientId
          == request.resource.data.clientId

        && request.resource.data.createdAt
          == request.time;

      // Customer can read own QR token.
      allow get:
        if signedIn()
        && resource.data.customerId == uid();

      // Staff/Admin can resolve QR only for their own business.
      allow get:
        if canAccessClient(
          resource.data.get('clientId', '')
        );
    }

    // ============================================================
    // ADMIN ANALYTICS / AUDIT RECORDS
    // ============================================================

    match /activityLogs/{logId} {
      allow get, list: if isAdminOf(resource.data.get('clientId', ''));
    }

    match /metricsDaily/{metricId} {
      allow get, list: if isAdminOf(resource.data.get('clientId', ''));
    }

    match /customerMergeArchive/{archiveId} {
      allow get, list: if isAdminOf(resource.data.get('clientId', ''));
    }

    // Unspecified collections remain unavailable to Admins and Staff. Every
    // Admin read/write path above is bound to admins/{uid}.clientId; a Super
    // Admin marker never creates a cross-client Rules bypass.
  }
}
