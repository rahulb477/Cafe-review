# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public base URL used inside QR codes (no trailing slash). Required in production.
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Client served when the bare domain is opened.
NEXT_PUBLIC_DEFAULT_CLIENT=bake

# AI review provider (server-only — never prefix with NEXT_PUBLIC_)
# Leave AI_API_KEY empty to use the built-in MockAIProvider.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Per-client Wi-Fi passwords (server-only): WIFI_PASSWORD_<SLUG_IN_UPPER_SNAKE>
WIFI_PASSWORD_BAKE=
WIFI_PASSWORD_SHARMA_CAFE=

# Developer config console at /admin (always on outside production)
ADMIN_ENABLED=false

# ── Firebase (shared project: cafe-review7) ──────────────────────────────────
# Web config values are public identifiers; access is enforced by Security Rules.
# The app REFUSES to connect if NEXT_PUBLIC_FIREBASE_PROJECT_ID != cafe-review7.
NEXT_PUBLIC_FIREBASE_API_KEY=            # copy the exact 39-char key from Firebase console
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cafe-review7.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://cafe-review7-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cafe-review7
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cafe-review7.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=186233902821
NEXT_PUBLIC_FIREBASE_APP_ID=1:186233902821:web:4192c5da4967503512660c
# hybrid (Firestore + bundled demo fallback) | firebase (Firestore only) | local
NEXT_PUBLIC_CLIENT_SOURCE=hybrid

# OpenRouter for AI reviews (server-only)
OPENROUTER_API_KEY=
